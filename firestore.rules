rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /superTraders/game {
      allow read: if true;
      allow write: if false;
    }

    match /superTraders/admin {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }
  }
}
